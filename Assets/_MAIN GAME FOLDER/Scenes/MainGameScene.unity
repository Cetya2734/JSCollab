--- !u!1001 &55646171
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 5984505577223114755}
    m_Modifications:
    - target: {fileID: 2007084236364638274, guid: 2b8c3dc5eb3d8f045ad0bc487d4d3671, type: 3}
      propertyPath: m_text
      value: "\"If you're hearing this... you're still alive. That means they haven't
        found you yet.\"\n\n\"Listen carefully. You\u2019ll need to move (W, A, S,
        D) stay low, stay quiet. Don\u2019t waste time.\"\n\"Hold Shift to sprint\u2026
        but only if you have to. They sense the fast ones.\"\n\"If you find anything
        useful-press E to interact. Items, switches,.. You can press Tab to open
        your capacity manager and use them, just be quick about it.\"\n\n\"If you're
        unarmed, then it's suicide\"\n\"If you\u2019re armed, use Left Click to shoot
        and Right Click to aim. Aim for the bulbs. The light... it\u2019s their weakness.
        But don\u2019t get too close to anything that moves and glows.\"\n\n\"There\u2019s\u2026
        a keycard in this room. It opens a path deeper into the facility. If you
        value your life, leave it. But if you\u2019re desperate..\"\n\n...\n\n\"...may
        God help you.\""
      objectReference: {fileID: 0}
    - target: {fileID: 2007084236364638274, guid: 2b8c3dc5eb3d8f045ad0bc487d4d3671, type: 3}
      propertyPath: m_fontSize
